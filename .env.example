# PHOTO STUDIO AI — ZERO_SPEND_MODE
# Copy this file to .env and fill in ONLY the keys you obtain yourself.
# Never commit .env. Never paste secrets into source code or GitHub.
# All AI providers are optional. The app works for manual editing without any key.

# Enforced on the backend. Must be TRUE.
ZERO_SPEND_MODE=TRUE

# ---------------------------------------------------------------------------
# CATEGORY A — Conversational AI & image understanding
# Recommended: Google Gemini (free tier). Fallback: OpenRouter free models.
# Get keys yourself: https://aistudio.google.com/  and  https://openrouter.ai/
# ---------------------------------------------------------------------------
GEMINI_API_KEY=
OPENROUTER_API_KEY=
GEMINI_MODEL=gemini-1.5-flash-latest

# ---------------------------------------------------------------------------
# CATEGORY B — Image generation & editing (Cloudflare Workers AI)
# Free allocation: 10,000 Neurons/day (does NOT equal 10,000 images).
# Get token + account ID yourself: https://dash.cloudflare.com/
# ---------------------------------------------------------------------------
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-2-klein-4b

# ---------------------------------------------------------------------------
# CATEGORY C — Background segmentation (optional remote API)
# Leave blank to use the built-in deterministic image processor.
# ---------------------------------------------------------------------------
SEGMENTATION_API_URL=
SEGMENTATION_API_KEY=

# ---------------------------------------------------------------------------
# App (these values are server-side only — NOT exposed to the Vite frontend.
# They do NOT use the VITE_ prefix and are read only by Netlify Functions.)
# ---------------------------------------------------------------------------
# In production, set this to your Netlify site URL (e.g. https://yoursite.netlify.app).
# Defaults to localhost for local development only.
APP_URL=http://localhost:8888
